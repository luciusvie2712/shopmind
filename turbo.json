{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "SHOPMIND_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "^test:integration"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_ACCESS_SECRET",
        "JWT_ACCESS_TTL",
        "REFRESH_TOKEN_TTL_DAYS",
        "COOKIE_SECURE",
        "NODE_ENV"
      ],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "^test:e2e"],
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}