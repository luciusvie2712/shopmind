# Database / Redis
DATABASE_URL=postgresql://shopmind:shopmind_local@localhost:5432/shopmind
REDIS_URL=redis://localhost:6380

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# External product source
DUMMYJSON_BASE_URL=https://dummyjson.com

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
AI_TIMEOUT_MS=8000
AI_MAX_TOOL_STEPS=4

# App
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SHOPMIND_API_BASE_URL=http://localhost:4000/api/v1
NODE_ENV=development

# Public quick-contact links (optional)
NEXT_PUBLIC_CONTACT_PHONE=+84901234567
NEXT_PUBLIC_CONTACT_FACEBOOK_URL=https://www.facebook.com/your-page
NEXT_PUBLIC_CONTACT_ZALO_URL=https://zalo.me/84901234567
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Full-stack Docker Compose host ports (optional)
DEV_WEB_PORT=3000
DEV_API_PORT=4000
DEV_POSTGRES_PORT=5433
DEV_REDIS_PORT=6381
