generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String           @map("password_hash")
  name            String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now()) @map("created_at")
  refreshSessions RefreshSession[]
  cart            Cart?
  wishlistItems   WishlistItem[]
  orders          Order[]
  aiRequestLogs   AiRequestLog[]
  aiConversations AiConversation[]

  @@map("users")
}

model AiConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_ai_conversations_user_updated")
  @@map("ai_conversations")
}

model AiMessage {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String          @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id], map: "idx_ai_messages_conversation_created")
  @@map("ai_messages")
}

model AiRequestLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  operation    String   @db.VarChar(100)
  model        String   @db.VarChar(100)
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  latencyMs    Float    @map("latency_ms")
  status       String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([operation, createdAt(sort: Desc)], map: "idx_ai_request_logs_operation_created")
  @@map("ai_request_logs")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_sessions")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  slug     String    @unique
  name     String
  products Product[]

  @@map("categories")
}

model Product {
  id            String            @id @default(uuid()) @db.Uuid
  source        String
  externalId    String            @map("external_id")
  categoryId    String            @map("category_id") @db.Uuid
  title         String
  description   String            @db.Text
  brand         String?
  price         Decimal           @db.Decimal(12, 2)
  rating        Decimal           @db.Decimal(3, 2)
  stock         Int
  thumbnail     String?
  metadata      Json              @default("{}")
  contentHash   String            @map("content_hash") @db.VarChar(64)
  sourceStatus  String            @default("ACTIVE") @map("source_status")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  category      Category          @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  reviews       ProductReview[]
  embedding     ProductEmbedding?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@unique([source, externalId])
  @@index([categoryId], map: "idx_products_category")
  @@index([price], map: "idx_products_price")
  @@index([rating(sort: Desc)], map: "idx_products_rating")
  @@index([brand], map: "idx_products_brand")
  @@map("products")
}

model ProductEmbedding {
  productId   String                     @id @map("product_id") @db.Uuid
  embedding   Unsupported("vector(768)")
  model       String                     @db.VarChar(100)
  contentHash String                     @map("content_hash") @db.VarChar(64)
  updatedAt   DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  product     Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_embeddings")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  sortOrder Int     @map("sort_order")
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductReview {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  rating       Decimal  @db.Decimal(3, 2)
  comment      String   @db.Text
  reviewerName String   @map("reviewer_name")
  reviewedAt   DateTime @map("reviewed_at")
  product      Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_reviews")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @map("cart_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model WishlistItem {
  userId    String  @map("user_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  status    String      @default("CREATED")
  subtotal  Decimal     @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]

  @@index([userId, createdAt(sort: Desc)], map: "idx_orders_user_created")
  @@map("orders")
}

model OrderItem {
  id                   String  @id @default(uuid()) @db.Uuid
  orderId              String  @map("order_id") @db.Uuid
  productId            String  @map("product_id") @db.Uuid
  productTitleSnapshot String  @map("product_title_snapshot")
  unitPriceSnapshot    Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity             Int
  order                Order   @relation(fields: [orderId], references: [id])
  product              Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
